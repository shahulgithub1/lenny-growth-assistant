# ============================================
# The Lenny Growth Assistant - Environment Configuration
# ============================================

# --------------------------------------------
# Database Configuration (REQUIRED)
# --------------------------------------------
DATABASE_URL=postgresql://lenny:lenny_dev_password@postgres:5432/lenny_growth_assistant

# PostgreSQL connection settings (used by docker-compose)
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny_dev_password
POSTGRES_DB=lenny_growth_assistant

# --------------------------------------------
# Model Provider Configuration (REQUIRED)
# --------------------------------------------
# Options: "ollama" or "anthropic"
# Default: "ollama" (works without API keys)
MODEL_PROVIDER=ollama

# --------------------------------------------
# Ollama Configuration (REQUIRED for local demo)
# --------------------------------------------
# Ollama base URL
# Use "http://host.docker.internal:11434" from Docker
# Use "http://localhost:11434" from host machine
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Ollama model name
# Recommended: llama3.2:3b, mistral:7b
# Must be downloaded first: ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b

# --------------------------------------------
# Anthropic Configuration (OPTIONAL)
# --------------------------------------------
# Anthropic API key - only required if MODEL_PROVIDER=anthropic
# Get your key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Anthropic model name
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --------------------------------------------
# Application Configuration
# --------------------------------------------
# Backend API URL (used by frontend)
VITE_API_URL=http://localhost:8000

# Backend host and port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend port
FRONTEND_PORT=5173

# --------------------------------------------
# Logging Configuration
# --------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --------------------------------------------
# FAISS and Retrieval Configuration
# --------------------------------------------
# Number of chunks to retrieve for RAG
RETRIEVAL_TOP_K=5

# Similarity threshold (0.0 to 1.0)
RETRIEVAL_THRESHOLD=0.25

# --------------------------------------------
# Notes
# --------------------------------------------
# REQUIRED variables:
# - DATABASE_URL
# - MODEL_PROVIDER
# - OLLAMA_BASE_URL (if using Ollama)
# - OLLAMA_MODEL (if using Ollama)
#
# OPTIONAL variables:
# - ANTHROPIC_API_KEY (only if MODEL_PROVIDER=anthropic)
# - ANTHROPIC_MODEL (only if MODEL_PROVIDER=anthropic)
#
# Never commit the .env file to version control!
# Copy this file to .env and update with your values:
#   cp .env.example .env
